<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Act\InformationBar\Subscriber\InformationBarSubscriber">
            <argument type="service" id="Act\InformationBar\Service\InformationBarTextLoader"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Act\InformationBar\Service\BarScheduleResolver"/>

        <service id="Act\InformationBar\Service\BarDefaultsProvider" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Act\InformationBar\Controller\InformationBarDefaultsController" public="true">
            <argument type="service" id="Act\InformationBar\Service\BarDefaultsProvider"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Act\InformationBar\Service\InformationBarTextLoader">
            <argument type="service" id="act_information_bar.repository"/>
            <argument type="service" id="Act\InformationBar\Service\BarScheduleResolver"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Act\InformationBar\Service\BarDefaultsProvider"/>
        </service>

        <service id="Act\InformationBar\Content\InformationBar\InformationBarDefinition">
            <tag name="shopware.entity.definition" entity="act_information_bar"/>
        </service>

        <service id="Act\InformationBar\Content\InformationBar\Aggregate\InformationBarTranslation\InformationBarTranslationDefinition">
            <tag name="shopware.entity.definition"/>
        </service>
    </services>
</container>
