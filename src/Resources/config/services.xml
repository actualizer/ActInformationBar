<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Act\InformationBar\Subscriber\InformationBarSubscriber">
            <argument type="service" id="Act\InformationBar\Service\InformationBarTextLoader"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="Act\InformationBar\Service\Text\BarTextFilter"/>
            <argument type="service" id="Act\InformationBar\Service\Countdown\CountdownViewFactory"/>
            <argument type="service" id="clock"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Act\InformationBar\Subscriber\CacheInvalidationSubscriber">
            <argument type="service" id="Shopware\Core\Framework\Adapter\Cache\CacheInvalidator"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Act\InformationBar\Service\Text\BarTextFilter"/>

        <service id="Act\InformationBar\Service\Countdown\CountdownViewFactory">
            <argument type="service" id="Act\InformationBar\Service\Text\BarTextFilter"/>
        </service>

        <service id="Act\InformationBar\Subscriber\BarTextWriteSubscriber">
            <argument type="service" id="Act\InformationBar\Service\Text\BarTextFilter"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Act\InformationBar\ScheduledTask\ScheduleCacheTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Act\InformationBar\ScheduledTask\ScheduleCacheTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\Adapter\Cache\CacheInvalidator"/>
            <argument type="service" id="clock"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Act\InformationBar\Service\BarScheduleResolver"/>

        <service id="Act\InformationBar\Service\BarDefaultsProvider" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Act\InformationBar\Controller\InformationBarDefaultsController" public="true">
            <argument type="service" id="Act\InformationBar\Service\BarDefaultsProvider"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Act\InformationBar\Controller\InformationBarPreviewController" public="true">
            <argument type="service" id="Act\InformationBar\Service\Text\BarTextFilter"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Act\InformationBar\Service\InformationBarTextLoader">
            <argument type="service" id="act_information_bar.repository"/>
            <argument type="service" id="Act\InformationBar\Service\BarScheduleResolver"/>
            <argument type="service" id="clock"/>
            <argument type="service" id="Act\InformationBar\Service\BarDefaultsProvider"/>
        </service>

        <service id="Act\InformationBar\Content\InformationBar\InformationBarDefinition">
            <tag name="shopware.entity.definition" entity="act_information_bar"/>
        </service>

        <service id="Act\InformationBar\Content\InformationBar\Aggregate\InformationBarTranslation\InformationBarTranslationDefinition">
            <tag name="shopware.entity.definition"/>
        </service>
    </services>
</container>
