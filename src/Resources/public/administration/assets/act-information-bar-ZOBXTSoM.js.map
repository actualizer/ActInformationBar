<div>
    {% block act_information_bar_info %}
        <mt-banner variant="attention" :hideIcon="true">
            {{ $tc('actInformationBar.settings.info.description') }}
            <br><br>
            <sw-internal-link :router-link="{ name: 'act.information.bar.index' }">
                {{ $tc('actInformationBar.settings.info.openModuleLink') }}
            </sw-internal-link>
            <div style="margin-top: 25px; margin-bottom: 10px;">
                <img src="data:image/svg+xml;base64," alt="Actualize" style="height: 28px;">
            </div>
            <a href="https://www.actualize.de" target="_blank" rel="noopener">www.actualize.de</a>
            <br><br>
            {{ $tc('actInformationBar.settings.info.issues') }}
            <a href="https://github.com/actualizer/ActInformationBar/issues" target="_blank" rel="noopener">GitHub Issues</a>
        </mt-banner>
    {% endblock %}
</div>
