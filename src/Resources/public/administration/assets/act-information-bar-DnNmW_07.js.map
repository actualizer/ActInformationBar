{% block act_information_bar_detail %}
<sw-page class="act-information-bar-detail">
    {% block act_information_bar_detail_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('actInformationBar.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {% block act_information_bar_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch @on-change="onLanguageChanged"></sw-language-switch>
    </template>
    {% endblock %}

    {% block act_information_bar_detail_actions %}
    <template #smart-bar-actions>
        <mt-button
            variant="primary"
            :is-loading="isSaving"
            v-tooltip="saveButtonTooltip"
            :disabled="!acl.can('act_information_bar.editor') || undefined"
            @click="onSave"
        >
            {{ $tc('global.default.save') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block act_information_bar_detail_content %}
    <template #content>
        <sw-card-view>
            {% block act_information_bar_detail_general_card %}
            <mt-card :title="$tc('actInformationBar.detail.generalCardTitle')" :is-loading="isLoading">
                <!-- bar and timezone resolve as two independent promises inside the same
                     Promise.all in loadData(); gating on isLoading too (not just bar) keeps
                     the datepickers below from ever mounting against the stale initial 'UTC'
                     default before the real shop timezone has arrived. -->
                <template v-if="bar && !isLoading">
                    {% block act_information_bar_detail_field_name %}
                    <mt-text-field
                        name="sw-field--act-information-bar-name"
                        :label="$tc('actInformationBar.detail.nameLabel')"
                        :model-value="bar.name"
                        @update:model-value="onFieldInput('name', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_active %}
                    <mt-switch
                        name="sw-field--act-information-bar-active"
                        :label="$tc('actInformationBar.detail.activeLabel')"
                        :model-value="bar.active"
                        @update:model-value="onFieldInput('active', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_sales_channel %}
                    <sw-entity-single-select
                        entity="sales_channel"
                        :label="$tc('actInformationBar.detail.salesChannelLabel')"
                        :placeholder="$tc('actInformationBar.list.allSalesChannels')"
                        :value="bar.salesChannelId"
                        @update:value="onFieldInput('salesChannelId', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_group_dates %}
                    <sw-container columns="repeat(auto-fit, minmax(250px, 1fr))" gap="0px 30px">
                        {% block act_information_bar_detail_field_start_date %}
                        <mt-datepicker
                            name="sw-field--act-information-bar-start-date"
                            date-type="datetime"
                            :label="$tc('actInformationBar.detail.startDateLabel')"
                            :help-text="$t('actInformationBar.detail.timezoneHint', { timezone: timezone })"
                            :time-zone="timezone"
                            :model-value="bar.startDate"
                            @update:model-value="onFieldInput('startDate', $event)"
                        />
                        {% endblock %}

                        {% block act_information_bar_detail_field_end_date %}
                        <mt-datepicker
                            name="sw-field--act-information-bar-end-date"
                            date-type="datetime"
                            :label="$tc('actInformationBar.detail.endDateLabel')"
                            :help-text="$t('actInformationBar.detail.timezoneHint', { timezone: timezone })"
                            :time-zone="timezone"
                            :model-value="bar.endDate"
                            @update:model-value="onFieldInput('endDate', $event)"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}
                </template>
            </mt-card>
            {% endblock %}

            {% block act_information_bar_detail_content_card %}
            <mt-card :title="$tc('actInformationBar.detail.contentCardTitle')" :is-loading="isLoading">
                <template v-if="bar">
                    {% block act_information_bar_detail_field_message %}
                    <mt-textarea
                        name="sw-field--act-information-bar-message"
                        :label="$tc('actInformationBar.detail.messageLabel')"
                        :help-text="$tc('actInformationBar.detail.messageHelpText')"
                        :model-value="bar.message"
                        @update:model-value="onFieldInput('message', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_button_text %}
                    <mt-text-field
                        name="sw-field--act-information-bar-button-text"
                        :label="$tc('actInformationBar.detail.buttonTextLabel')"
                        :model-value="bar.buttonText"
                        @update:model-value="onFieldInput('buttonText', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_button_url %}
                    <mt-text-field
                        name="sw-field--act-information-bar-button-url"
                        :label="$tc('actInformationBar.detail.buttonUrlLabel')"
                        :model-value="bar.buttonUrl"
                        @update:model-value="onFieldInput('buttonUrl', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_button_title %}
                    <mt-text-field
                        name="sw-field--act-information-bar-button-title"
                        :label="$tc('actInformationBar.detail.buttonTitleLabel')"
                        :model-value="bar.buttonTitle"
                        @update:model-value="onFieldInput('buttonTitle', $event)"
                    />
                    {% endblock %}
                </template>
            </mt-card>
            {% endblock %}

            {% block act_information_bar_detail_appearance_card %}
            <mt-card :title="$tc('actInformationBar.detail.appearanceCardTitle')" :is-loading="isLoading">
                <template v-if="bar">
                    {% block act_information_bar_detail_appearance_language_hint %}
                    <mt-banner variant="info">
                        {{ $tc('actInformationBar.detail.appearanceLanguageHint') }}
                    </mt-banner>
                    {% endblock %}

                    {% block act_information_bar_detail_appearance_group_status %}
                    <h3 class="act-information-bar-detail__appearance-group-title">{{ $tc('actInformationBar.detail.appearanceStatusGroupTitle') }}</h3>

                    {% block act_information_bar_detail_field_full_width %}
                    <mt-switch
                        name="sw-field--act-information-bar-full-width"
                        :label="$tc('actInformationBar.detail.fullWidthLabel')"
                        :model-value="bar.fullWidth"
                        @update:model-value="onFieldInput('fullWidth', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_display_duration %}
                    <mt-number-field
                        name="sw-field--act-information-bar-display-duration"
                        number-type="int"
                        :min="1"
                        :max="10"
                        :label="$tc('actInformationBar.detail.displayDurationLabel')"
                        :model-value="bar.displayDuration"
                        @update:model-value="onFieldInput('displayDuration', $event)"
                    />
                    {% endblock %}
                    {% endblock %}

                    {% block act_information_bar_detail_appearance_group_colors %}
                    <h3 class="act-information-bar-detail__appearance-group-title">{{ $tc('actInformationBar.detail.appearanceColorsGroupTitle') }}</h3>

                    {% block act_information_bar_detail_field_group_colors %}
                    <sw-container columns="repeat(auto-fit, minmax(250px, 1fr))" gap="0px 30px">
                        {% block act_information_bar_detail_field_text_color %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-text-color"
                            :label="$tc('actInformationBar.detail.textColorLabel')"
                            :model-value="bar.textColor"
                            @update:model-value="onFieldInput('textColor', $event)"
                        />
                        {% endblock %}

                        {% block act_information_bar_detail_field_background_color %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-background-color"
                            :label="$tc('actInformationBar.detail.backgroundColorLabel')"
                            :model-value="bar.backgroundColor"
                            @update:model-value="onFieldInput('backgroundColor', $event)"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block act_information_bar_detail_field_group_padding %}
                    <sw-container columns="repeat(auto-fit, minmax(250px, 1fr))" gap="0px 30px">
                        {% block act_information_bar_detail_field_padding_top %}
                        <mt-text-field
                            name="sw-field--act-information-bar-padding-top"
                            :label="$tc('actInformationBar.detail.paddingTopLabel')"
                            :model-value="bar.paddingTop"
                            @update:model-value="onFieldInput('paddingTop', $event)"
                        />
                        {% endblock %}

                        {% block act_information_bar_detail_field_padding_bottom %}
                        <mt-text-field
                            name="sw-field--act-information-bar-padding-bottom"
                            :label="$tc('actInformationBar.detail.paddingBottomLabel')"
                            :model-value="bar.paddingBottom"
                            @update:model-value="onFieldInput('paddingBottom', $event)"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block act_information_bar_detail_field_font_size %}
                    <mt-text-field
                        name="sw-field--act-information-bar-font-size"
                        :label="$tc('actInformationBar.detail.fontSizeLabel')"
                        :model-value="bar.fontSize"
                        @update:model-value="onFieldInput('fontSize', $event)"
                    />
                    {% endblock %}
                    {% endblock %}

                    {% block act_information_bar_detail_appearance_group_button %}
                    <h3 class="act-information-bar-detail__appearance-group-title">{{ $tc('actInformationBar.detail.appearanceButtonGroupTitle') }}</h3>

                    {% block act_information_bar_detail_field_show_button %}
                    <mt-switch
                        name="sw-field--act-information-bar-show-button"
                        :label="$tc('actInformationBar.detail.showButtonLabel')"
                        :model-value="bar.showButton"
                        @update:model-value="onFieldInput('showButton', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_button_target %}
                    <mt-select
                        name="sw-field--act-information-bar-button-target"
                        :label="$tc('actInformationBar.detail.buttonTargetLabel')"
                        :options="buttonTargetOptions"
                        :model-value="bar.buttonTarget"
                        @update:model-value="onFieldInput('buttonTarget', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_group_button_text_color %}
                    <sw-container columns="repeat(auto-fit, minmax(250px, 1fr))" gap="0px 30px">
                        {% block act_information_bar_detail_field_button_text_color %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-button-text-color"
                            :label="$tc('actInformationBar.detail.buttonTextColorLabel')"
                            :model-value="bar.buttonTextColor"
                            @update:model-value="onFieldInput('buttonTextColor', $event)"
                        />
                        {% endblock %}

                        {% block act_information_bar_detail_field_button_text_color_hover %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-button-text-color-hover"
                            :label="$tc('actInformationBar.detail.buttonTextColorHoverLabel')"
                            :model-value="bar.buttonTextColorHover"
                            @update:model-value="onFieldInput('buttonTextColorHover', $event)"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block act_information_bar_detail_field_group_button_border_color %}
                    <sw-container columns="repeat(auto-fit, minmax(250px, 1fr))" gap="0px 30px">
                        {% block act_information_bar_detail_field_button_border_color %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-button-border-color"
                            :label="$tc('actInformationBar.detail.buttonBorderColorLabel')"
                            :model-value="bar.buttonBorderColor"
                            @update:model-value="onFieldInput('buttonBorderColor', $event)"
                        />
                        {% endblock %}

                        {% block act_information_bar_detail_field_button_border_color_hover %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-button-border-color-hover"
                            :label="$tc('actInformationBar.detail.buttonBorderColorHoverLabel')"
                            :model-value="bar.buttonBorderColorHover"
                            @update:model-value="onFieldInput('buttonBorderColorHover', $event)"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block act_information_bar_detail_field_button_border_width %}
                    <mt-text-field
                        name="sw-field--act-information-bar-button-border-width"
                        :label="$tc('actInformationBar.detail.buttonBorderWidthLabel')"
                        :model-value="bar.buttonBorderWidth"
                        @update:model-value="onFieldInput('buttonBorderWidth', $event)"
                    />
                    {% endblock %}

                    {% block act_information_bar_detail_field_group_button_background_color %}
                    <sw-container columns="repeat(auto-fit, minmax(250px, 1fr))" gap="0px 30px">
                        {% block act_information_bar_detail_field_button_background_color %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-button-background-color"
                            :label="$tc('actInformationBar.detail.buttonBackgroundColorLabel')"
                            :model-value="bar.buttonBackgroundColor"
                            @update:model-value="onFieldInput('buttonBackgroundColor', $event)"
                        />
                        {% endblock %}

                        {% block act_information_bar_detail_field_button_background_color_hover %}
                        <mt-colorpicker
                            name="sw-field--act-information-bar-button-background-color-hover"
                            :label="$tc('actInformationBar.detail.buttonBackgroundColorHoverLabel')"
                            :model-value="bar.buttonBackgroundColorHover"
                            @update:model-value="onFieldInput('buttonBackgroundColorHover', $event)"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}
                    {% endblock %}
                </template>
            </mt-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
