parameters:
    level: 8
    # PHPDoc types are HINTS, not GUARANTEES. Lazy DAL hydration, framework
    # version drift, and subscriber ordering can violate them at runtime.
    # Treat them as uncertain so defensive `?->`/`?? default`/`is_*()` guards
    # are NOT flagged as redundant. Defense stays.
    treatPhpDocTypesAsCertain: false
    paths:
        - src/
    excludePaths:
        - src/Migration/*
    # The DAL offers no public API to rewrite a payload before it is written
    # (BarTextWriteSubscriber). Unmatched locally: the Shopware rule is only in shopware-cli.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: shopware.internalMethodCall
            path: src/Subscriber/BarTextWriteSubscriber.php
